# Copy to .env locally. Never commit credentials.
DATABASE_URL=postgresql+psycopg://clauseguard:change-me@localhost:5433/clauseguard
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Optional source DB used only by scripts/migrate_cg_user.py. Copies user rows only.
SOURCE_CG_USER_DATABASE_URL=

# Existing Docker Desktop services. Set these to their published host ports.
QDRANT_URL=http://localhost:6333
RABBITMQ_URL=amqp://clauseguard:change-me@localhost:5672//
REDIS_URL=redis://localhost:6379/4
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

OBJECT_STORE_BACKEND=filesystem
LOCAL_OBJECT_PATH=deploy/object-data

# Used only when OBJECT_STORE_BACKEND=s3.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=clauseguard-documents

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
QDRANT_COLLECTION=clauseguard_chunks
